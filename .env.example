# =============================================================================
# Sheeba — environment configuration
# Copy to .env and fill real values. Never commit .env.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_NAME=Sheeba
APP_HOST=0.0.0.0
# On multi-tenant VPS, pick a free port (8000 may already be used).
APP_PORT=8041
PUBLIC_API_URL=https://api.aisheeba.bejjam.com
LOG_LEVEL=INFO
JSON_LOGS=true

# --- Database (existing Postgres on VPS) ---
DATABASE_URL=postgresql+asyncpg://sheeba:CHANGE_ME@127.0.0.1:5432/sheeba
DATABASE_POOL_SIZE=10

# --- Redis (existing Redis on VPS; prefer an unused DB index) ---
REDIS_URL=redis://127.0.0.1:6379/15

# --- AI brain ---
# fake | cursor_sdk
AI_PROVIDER=fake
AI_API_KEY=
CURSOR_SDK_BASE_URL=http://127.0.0.1:3000
CURSOR_API_KEY=

# --- Telephony ---
TELEPHONY_PROVIDER=fake
TELEPHONY_API_KEY=
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_WEBHOOK_BASE_URL=https://api.aisheeba.bejjam.com/api/v1

# --- Calendar (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.aisheeba.bejjam.com/api/v1/calendar/oauth/callback

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Storage ---
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Security ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://aisheeba.bejjam.com,http://aisheeba.bejjam.com

# --- Recording / privacy ---
RECORDING_ENABLED=false
TRANSCRIPTION_ENABLED=true
RETENTION_DAYS=30

# =============================================================================
# Deployment — API VPS (password auth, no SSH keys)
# =============================================================================
VPS_HOST=CHANGE_ME_VPS_IP_OR_HOSTNAME
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=CHANGE_ME_ROOT_PASSWORD
VPS_APP_DIR=/opt/sheeba
VPS_SERVICE_NAME=sheeba-api
VPS_PYTHON=python3.12
# Optional: existing nginx sites path on the VPS
VPS_NGINX_AVAILABLE=/etc/nginx/sites-available
VPS_NGINX_ENABLED=/etc/nginx/sites-enabled
# API reverse-proxy listen (choose a free port / server_name that won't clash)
VPS_API_SERVER_NAME=api.aisheeba.bejjam.com
VPS_API_UPSTREAM_PORT=8041

# =============================================================================
# Deployment — UI via FTP (separate host/IP from API VPS)
# =============================================================================
# Host only (no ftp:// prefix)
FTP_HOST=CHANGE_ME_UI_FTP_IP_OR_HOSTNAME
FTP_PORT=21
FTP_USER=CHANGE_ME_FTP_USER
FTP_PASSWORD=CHANGE_ME_FTP_PASSWORD
FTP_REMOTE_DIR=/
VITE_API_BASE_URL=https://api.aisheeba.bejjam.com
FTP_SSL=false
